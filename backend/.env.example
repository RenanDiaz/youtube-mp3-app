# Server Configuration
NODE_ENV=development
PORT=5001
HOST=localhost

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Download Configuration
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT_MS=600000
MAX_FILE_SIZE_MB=500
CLEANUP_INTERVAL_HOURS=24
DOWNLOADS_DIR=./downloads

# Audio Format Configuration
DEFAULT_AUDIO_FORMAT=mp3
ALLOWED_FORMATS=mp3,wav,flac,m4a,aac,opus

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
DOWNLOAD_TOKEN_EXPIRY_MS=300000

# yt-dlp
# Path to the yt-dlp binary (default: resolved from PATH)
YTDLP_PATH=yt-dlp
# Retries for network / extractor errors
YTDLP_RETRIES=5
YTDLP_SOCKET_TIMEOUT=30
# Seconds yt-dlp sleeps between HTTP requests
YTDLP_SLEEP_REQUESTS=1
# Milliseconds the backend waits between two tracks of a multi-download
YTDLP_DELAY_BETWEEN_DOWNLOADS_MS=1500
#
# --- HTTP 403 / "Sign in to confirm you're not a bot" mitigations ---
# 1. Keep yt-dlp updated first: yt-dlp -U   (or: brew upgrade yt-dlp / pip install -U yt-dlp)
# 2. Cookies are the most effective fix. Either take them from a logged-in browser...
#    (chrome | chromium | brave | edge | firefox | opera | safari | vivaldi)
# YTDLP_COOKIES_FROM_BROWSER=chrome
#    ...or export them to a Netscape cookies.txt file:
# YTDLP_COOKIES_FILE=./cookies.txt
# 3. As a last resort, force which InnerTube clients yt-dlp impersonates:
# YTDLP_PLAYER_CLIENTS=tv,web_safari
# 4. Optional custom User-Agent
# YTDLP_USER_AGENT=
